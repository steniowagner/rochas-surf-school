# Manual REST Client requests for POST /classes/batch and GET /classes/time-range-suggestions (VS Code REST Client).
# Sign in with an approved admin review account of REVIEW_ACCOUNTS in apps/backend/.env: set the email and code below.
# Codes are read from the backend log when RESEND_API_KEY is unset.

@baseUrl = http://localhost:4000
@email = admin@example.com
@code = 345678

### Request a sign-in code (expects 202)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Sign in (expects 200 with accessToken)
# @name session
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

###
@token = {{session.response.body.accessToken}}

### Create a location to use below (expects 201 with { id, name, address })
# @name location
POST {{baseUrl}}/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Praia do Futuro",
  "address": "Av. Zezé Diogo, 5000 – Fortaleza"
}

###
@locationId = {{location.response.body.id}}
# Set the id of an approved instructor or admin (GET /people?role=instructor,admin) and a future date range.
@instructorId = 00000000-0000-4000-8000-000000000000

### Create a batch: one class per included day and time range (expects 201 with { count })
POST {{baseUrl}}/classes/batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "startDate": "2030-10-15",
  "endDate": "2030-10-17",
  "weekdays": [1, 2, 3, 4, 5, 6, 7],
  "timeRanges": [
    { "start": "08:00", "end": "09:00" },
    { "start": "16:00", "end": "17:00" }
  ],
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8,
  "notes": "Bring sunscreen"
}

### A batch that leaves out some dates of the range (expects 201 { count: 4 }: the 15th and the 17th, two time ranges each)
POST {{baseUrl}}/classes/batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "startDate": "2030-10-15",
  "endDate": "2030-10-17",
  "weekdays": [1, 2, 3, 4, 5, 6, 7],
  "excludedDates": ["2030-10-16"],
  "timeRanges": [
    { "start": "08:00", "end": "09:00" },
    { "start": "16:00", "end": "17:00" }
  ],
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8
}

### A batch that skips the classes that already started (expects 201 with only the future classes; without skipPast a past class gives 422 class.startsAt.past)
POST {{baseUrl}}/classes/batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "startDate": "2030-10-15",
  "endDate": "2030-10-17",
  "weekdays": [1, 2, 3, 4, 5, 6, 7],
  "skipPast": true,
  "timeRanges": [{ "start": "08:00", "end": "09:00" }],
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8
}

### An invalid batch (expects 422 with every failure in errors, e.g. class.discipline.invalid, class.timeRanges.overlap, class.capacity.invalid)
POST {{baseUrl}}/classes/batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "tennis",
  "level": "beginner",
  "startDate": "2030-10-15",
  "endDate": "2030-10-15",
  "weekdays": [1, 2, 3, 4, 5, 6, 7],
  "timeRanges": [
    { "start": "08:00", "end": "09:00" },
    { "start": "08:30", "end": "09:30" }
  ],
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 0
}

### A batch in the past (expects 422 class.startsAt.past)
POST {{baseUrl}}/classes/batch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "startDate": "2020-01-01",
  "endDate": "2020-01-01",
  "weekdays": [1, 2, 3, 4, 5, 6, 7],
  "timeRanges": [{ "start": "08:00", "end": "09:00" }],
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8
}

### Time range suggestions from last week's classes (expects 200 with { items: [{ start, end }] }; admins only)
GET {{baseUrl}}/classes/time-range-suggestions
Authorization: Bearer {{token}}

### Without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/classes/time-range-suggestions

### As a student or instructor (expects 403 user.role.notAdmin): use that account's token
GET {{baseUrl}}/classes/time-range-suggestions
Authorization: Bearer {{token}}

### The classes of the week that holds a date, Monday to Sunday in Fortaleza (expects 200 with { weekStart, items }; any approved account)
GET {{baseUrl}}/classes?date=2026-10-15
Authorization: Bearer {{token}}

### A missing, malformed or impossible date (expects 422 class.date.invalid)
GET {{baseUrl}}/classes?date=2026-02-30
Authorization: Bearer {{token}}

### Without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/classes?date=2026-10-15

### One class by id (expects 200 with the class; set classId to an id from the week list)
@classId = 00000000-0000-4000-8000-000000000000
GET {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}

### An unknown or malformed id (expects 404 class.notFound)
GET {{baseUrl}}/classes/not-a-uuid
Authorization: Bearer {{token}}

### Edit a class (expects 200 with the updated class; admins only; the whole class every time; date and times in Fortaleza)
PUT {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "date": "2026-10-21",
  "start": "08:00",
  "end": "09:00",
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8,
  "notes": "Bring sunscreen"
}

### A start in the past (expects 422 class.startsAt.past)
PUT {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "date": "2020-01-01",
  "start": "08:00",
  "end": "09:00",
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 8
}

### A class that has started: only the instructors change (expects 409 class.started for any other field)
PUT {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "discipline": "surf",
  "level": "beginner",
  "date": "2026-10-21",
  "start": "08:00",
  "end": "09:00",
  "locationId": "{{locationId}}",
  "instructorIds": ["{{instructorId}}"],
  "capacity": 12
}

### An invalid body (expects 422 with every shape key)
PUT {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### An unknown or malformed id (expects 404 class.notFound)
PUT {{baseUrl}}/classes/not-a-uuid
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### As a student or instructor (expects 403 user.role.notAdmin) or without a token (expects 401)
PUT {{baseUrl}}/classes/{{classId}}
Content-Type: application/json

{}

### Cancel a class (expects 200 with the class and its cancelledAt / cancellationMessage; admins only; final; the message is optional, up to 300 characters)
POST {{baseUrl}}/classes/{{classId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": "Mar muito grande. Remarcamos para sábado no mesmo horário."
}

### Without a message (expects 200 with cancellationMessage null)
POST {{baseUrl}}/classes/{{classId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### An already cancelled class (expects 409 class.cancelled) or a finished one (expects 409 class.finished)
POST {{baseUrl}}/classes/{{classId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### A message over 300 characters or not a string (expects 422 class.cancellationMessage.max.length)
POST {{baseUrl}}/classes/{{classId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "message": 42
}

### An unknown or malformed id (expects 404 class.notFound)
POST {{baseUrl}}/classes/not-a-uuid/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### As a student or instructor (expects 403 user.role.notAdmin) or without a token (expects 401)
POST {{baseUrl}}/classes/{{classId}}/cancel
Content-Type: application/json

{}

### Delete a class (expects 204 with no body; admins only; only before it starts, never a cancelled one, and only with nobody in it)
DELETE {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}

### A class that has started or finished (expects 409 class.started) or a cancelled one (expects 409 class.cancelled)
DELETE {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}

### A class with seats or pending requests (expects 409 class.delete.notEmpty with details { seatsTaken, pendingRequests }; cannot happen until enrolment exists)
DELETE {{baseUrl}}/classes/{{classId}}
Authorization: Bearer {{token}}

### An unknown, malformed or already deleted id (expects 404 class.notFound)
DELETE {{baseUrl}}/classes/not-a-uuid
Authorization: Bearer {{token}}

### As a student or instructor (expects 403 user.role.notAdmin) or without a token (expects 401)
DELETE {{baseUrl}}/classes/{{classId}}
