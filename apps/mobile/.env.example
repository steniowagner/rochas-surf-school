EXPO_PUBLIC_API_URL=http://localhost:4000

# Google sign-in (not secret). The web client ID is the audience of the ID token the backend checks.
# The iOS URL scheme goes in app.json, in the google-signin config plugin:
# com.googleusercontent.apps.983109126096-l33hhbs4p1o2842p9f5qdc1a4urlph6g
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=983109126096-mtlaj0n6ngcr4t79kkl1skib5ofk69e9.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=983109126096-l33hhbs4p1o2842p9f5qdc1a4urlph6g.apps.googleusercontent.com

# The web app, where the privacy policy and the terms of use live (/{lang}/privacy-policy, /{lang}/terms-of-use).
# Without it the Profile hides both rows.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
