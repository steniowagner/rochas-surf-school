# Manual REST Client requests for the auth module (VS Code REST Client).
# With RESEND_API_KEY unset outside production, the backend logs the code instead of emailing it.

@baseUrl = http://localhost:4000
@scenarioVersion = {{$timestamp}}
@email = ana.{{scenarioVersion}}@example.com

### Request a sign-in code (expects 202 with resendAvailableAt and expiresAt)
# @name requestCode
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Request again within 30 seconds (expects 429 signInCode.resend.tooSoon with details.resendAvailableAt)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Invalid email (expects 422 signInCode.email.invalid)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "ana@",
  "locale": "en"
}

### Unknown locale (expects 422 signInCode.locale.invalid)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "bia.{{scenarioVersion}}@example.com",
  "locale": "fr"
}

### Verify with a wrong code (expects 401 signInCode.code.invalid; counts an attempt)
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "000000"
}

### Verify without a name — for a new email, expects 422 user.name.required and the code stays usable
# Replace the code with the one logged by the backend (or received by email).
@code = 123456
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

### Verify with the name (expects 200 with accessToken, refreshToken and user; the code is consumed)
# @name verify
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}",
  "name": "Ana Rocha"
}

### Verify the same code again (expects 401 signInCode.code.invalid: a code is used once)
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

### Current account (expects 200 with id, name, email, role, status, createdAt, whatsappNumber and whatsappVisible; any account status)
# Replace the token with the accessToken returned by the verify request above.
@accessToken = paste-the-access-token-here
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Current account without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/auth/me

### Send the reactivation request (expects 200 with the account, status "deleted" and reactivationStatus "requested"; only a deleted account)
# Delete the account first: UPDATE users SET status = 'deleted', deleted_at = now() WHERE email = '<email>'
POST {{baseUrl}}/auth/me/reactivation-request
Authorization: Bearer {{accessToken}}

### Send the reactivation request again (expects 200 with the same account; the first request date is kept)
POST {{baseUrl}}/auth/me/reactivation-request
Authorization: Bearer {{accessToken}}

### Send the reactivation request after a denial (expects 409 user.reactivation.denied)
# Deny it first: UPDATE users SET reactivation_status = 'denied' WHERE email = '<email>'
POST {{baseUrl}}/auth/me/reactivation-request
Authorization: Bearer {{accessToken}}

### Send the reactivation request from an account that is not deleted (expects 403 user.status.notDeleted)
# Use the accessToken of a pending, approved, denied or removed account.
POST {{baseUrl}}/auth/me/reactivation-request
Authorization: Bearer {{accessToken}}

### Send the reactivation request without a token (expects 401 auth.token.invalid)
POST {{baseUrl}}/auth/me/reactivation-request

### Save the WhatsApp number (expects 200 with the account including whatsappNumber and whatsappVisible; only an approved account)
# Approve the account first: UPDATE users SET status = 'approved' WHERE email = '<email>'
PUT {{baseUrl}}/auth/me/whatsapp
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "whatsappNumber": "+5585999998888",
  "whatsappVisible": false
}

### Replace the WhatsApp number and visibility (expects 200 with the new values)
PUT {{baseUrl}}/auth/me/whatsapp
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "whatsappNumber": "+351912345678",
  "whatsappVisible": true
}

### Save an invalid WhatsApp number (expects 422 user.whatsappNumber.phone; nothing is saved)
PUT {{baseUrl}}/auth/me/whatsapp
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "whatsappNumber": "+55123",
  "whatsappVisible": false
}

### Save without the visibility (expects 422 user.whatsappVisible.required)
PUT {{baseUrl}}/auth/me/whatsapp
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "whatsappNumber": "+5585999998888"
}

### Save the WhatsApp number of a pending account (expects 403 user.status.notApproved)
# Use the accessToken of an account that is still pending.
PUT {{baseUrl}}/auth/me/whatsapp
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "whatsappNumber": "+5585999998888",
  "whatsappVisible": false
}

### Save the WhatsApp number without a token (expects 401 auth.token.invalid)
PUT {{baseUrl}}/auth/me/whatsapp
Content-Type: application/json

{
  "whatsappNumber": "+5585999998888",
  "whatsappVisible": false
}

### Renew the session (expects 200 with a new accessToken and refreshToken, same shape as verify; the sent token is revoked)
# Replace the token with the refreshToken returned by verify or by the previous refresh.
@refreshToken = paste-the-refresh-token-here
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Renew with the same token again (expects 401 auth.refreshToken.invalid and revokes the whole sign-in)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Renew without a token (expects 422 refreshToken.token.required)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{}

### Sign out (expects 204 with no body; ends this sign-in only, other devices stay signed in; needs no access token)
POST {{baseUrl}}/auth/sign-out
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Sign out again with the same token (expects 204: it is idempotent)
POST {{baseUrl}}/auth/sign-out
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Sign out without a token (expects 422 refreshToken.token.required)
POST {{baseUrl}}/auth/sign-out
Content-Type: application/json

{}
