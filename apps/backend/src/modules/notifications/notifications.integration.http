# Manual REST Client requests for the notifications module (VS Code REST Client).
# Sign in with an account of REVIEW_ACCOUNTS in apps/backend/.env: set the email and code below. Review accounts
# accept their fixed code after a code request (sent first, below). Pushes only reach a real device that
# registered a real Expo push token; any ExponentPushToken[...] value is accepted here.

@baseUrl = http://localhost:4000
@email = admin@example.com
@code = 345678

### Request a sign-in code (expects 202; with RESEND_API_KEY unset the backend logs the code)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Sign in (expects 200 with accessToken and refreshToken)
# @name session
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

###
@accessToken = {{session.response.body.accessToken}}
@refreshToken = {{session.response.body.refreshToken}}

### Register this device's push token (expects 204; pending and approved accounts only)
PUT {{baseUrl}}/notifications/push-token
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "token": "ExponentPushToken[review-admin]",
  "locale": "pt-BR"
}

### Register again with another language (expects 204; the same token keeps one row, now in English)
PUT {{baseUrl}}/notifications/push-token
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "token": "ExponentPushToken[review-admin]",
  "locale": "en"
}

### An invalid token and locale (expects 422 with pushToken.token.invalid and pushToken.locale.invalid)
PUT {{baseUrl}}/notifications/push-token
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "token": "abc",
  "locale": "fr"
}

### Without a token (expects 401 auth.token.invalid)
PUT {{baseUrl}}/notifications/push-token
Content-Type: application/json

{
  "token": "ExponentPushToken[review-admin]",
  "locale": "pt-BR"
}

### Unregister this device's push token (expects 204; any account status; an unknown token changes nothing)
DELETE {{baseUrl}}/notifications/push-token
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "token": "ExponentPushToken[review-admin]"
}

### Unregister without a token value (expects 422 pushToken.token.required)
DELETE {{baseUrl}}/notifications/push-token
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{}

### Unregister without a token (expects 401 auth.token.invalid)
DELETE {{baseUrl}}/notifications/push-token
Content-Type: application/json

{
  "token": "ExponentPushToken[review-admin]"
}

### List my notifications, newest first (expects 200 with items, page, perPage and total; text in the locale, pt-BR without one)
# @name notifications
GET {{baseUrl}}/notifications?page=1&perPage=20&locale=pt-BR
Authorization: Bearer {{accessToken}}

###
@notificationId = {{notifications.response.body.items[0].id}}

### The second page in English (expects 200)
GET {{baseUrl}}/notifications?page=2&locale=en
Authorization: Bearer {{accessToken}}

### Invalid paging and locale (expects 422 with notifications.page.invalid, notifications.perPage.invalid and notifications.locale.invalid)
GET {{baseUrl}}/notifications?page=0&perPage=51&locale=fr
Authorization: Bearer {{accessToken}}

### Count my unread notifications (expects 200 with { count })
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{accessToken}}

### Mark one notification read (expects 204; again keeps its first read time and still answers 204)
POST {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{accessToken}}

### Mark an unknown or someone else's notification read (expects 404 notification.notFound)
POST {{baseUrl}}/notifications/not-a-uuid/read
Authorization: Bearer {{accessToken}}

### Mark all my notifications read (expects 204)
POST {{baseUrl}}/notifications/read-all
Authorization: Bearer {{accessToken}}

### Count the recipients of a notice (admin only; expects 200 with { count }; audience is all, students or instructors)
GET {{baseUrl}}/notifications/broadcast/recipients?audience=students
Authorization: Bearer {{accessToken}}

### Count with an unknown audience (expects 422 with broadcast.audience.in)
GET {{baseUrl}}/notifications/broadcast/recipients?audience=everybody
Authorization: Bearer {{accessToken}}

### Send a notice (admin only; expects 204; title 1-60 and message 1-500 characters, shown as written)
POST {{baseUrl}}/notifications/broadcast
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "audience": "students",
  "title": "Aula cancelada",
  "message": "Sem aula amanhã por causa do mar."
}

### Send a blank title (expects 422 with broadcast.title.required; a message over 500 characters answers broadcast.message.range.length)
POST {{baseUrl}}/notifications/broadcast
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "audience": "all",
  "title": "   ",
  "message": "Mensagem"
}

### List without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/notifications

### Sign out and stop pushing to this device (expects 204)
POST {{baseUrl}}/auth/sign-out
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "pushToken": "ExponentPushToken[review-admin]"
}
