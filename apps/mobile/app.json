{
  "expo": {
    "name": "RSS",
    "slug": "rochas-surf-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rochassurfschool",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0E6D8",
    "ios": {
      "bundleIdentifier": "com.rochassurfschool.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0E6D8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rochassurfschool.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0E6D8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      "./plugins/with-ios-scene-lifecycle",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rocha's Surf School uses your location to centre the map when you add a class location."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.983109126096-l33hhbs4p1o2842p9f5qdc1a4urlph6g"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a5ce95a-6191-4a27-b81e-6d5a516564ac"
      }
    },
    "owner": "rochas-surf-school"
  }
}
