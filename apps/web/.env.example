NEXT_PUBLIC_API_URL=http://localhost:4000
# The school's WhatsApp number, in E.164 (+ country code and number, no spaces). Required at build time.
SCHOOL_WHATSAPP_NUMBER=+5585999999999
# The school's legal name, as the controller of the data in the privacy policy. Required at build time.
SCHOOL_LEGAL_NAME="Rocha Escola de Surf Ltda"
# The school's CNPJ (14 digits, with or without . / -). Optional: when unset, the policy shows no CNPJ.
# SCHOOL_CNPJ=11222333000181
# The data protection contact (encarregado, LGPD Art. 41): name and email. Required at build time.
DPO_NAME="Maria Rocha"
DPO_EMAIL=privacidade@example.com
