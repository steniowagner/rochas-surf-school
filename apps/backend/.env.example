PORT=4000

# PostgreSQL. DATABASE_HOST is overridden to `postgres` inside docker compose;
# keep `127.0.0.1` to run the backend on the host against the compose database. Not `localhost`: every new
# connection then resolves the name, and on macOS that lookup now and then hangs for 3-5 s, which fails e2e tests.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=rochas
DATABASE_PASSWORD=rochas
DATABASE_NAME=rochas_surf_school
JWT_SECRET=""
JWT_EXPIRES_IN="15m"

# Email (Resend). Without RESEND_API_KEY outside production, sign-in codes are logged instead of sent.
RESEND_API_KEY=""
EMAIL_FROM=""

# Sign-in. AUTH_CODE_PEPPER keys the HMAC of the sign-in codes (required).
AUTH_CODE_PEPPER=""
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
# JSON array of {"email","code","role","name"}: one pre-approved account per role, fixed 6-digit code.
# The 12 test sets (spec 076): `npm run test-accounts --workspace apps/backend` prints this value with fresh codes,
# plus their hand-out table. Set it only in the test server's environment; never commit the codes.
REVIEW_ACCOUNTS=""

# Google sign-in: the web client ID, which Google ID tokens from the app must name as their audience (not secret).
GOOGLE_WEB_CLIENT_ID=983109126096-mtlaj0n6ngcr4t79kkl1skib5ofk69e9.apps.googleusercontent.com

# Expo push (optional): only needed when "enhanced push security" is turned on for the project in Expo.
EXPO_ACCESS_TOKEN=""

# Anthropic (Claude) works out each class's cancellation deadline from the rule. Required in production; without it
# elsewhere, classes simply stay without a deadline.
ANTHROPIC_API_KEY=

# Google Maps Platform (Places API): address suggestions when admins save a class location. Required in production;
# without it elsewhere, suggestions are empty and the point is placed by hand on the map.
GOOGLE_MAPS_API_KEY=
