#!/bin/bash
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker

install -d -m 700 /etc/rochas

cat > /usr/local/bin/deploy-backend <<'SCRIPT'
#!/bin/bash
# Starts the backend image of the commit given as $1, with the values kept under ${parameter_path}.
set -euo pipefail

tag="$1"
image="${backend_image}:$tag"
env_file=/etc/rochas/backend.env

aws ssm get-parameters-by-path --region ${aws_region} --path ${parameter_path} --with-decryption \
  | jq -r '.Parameters[] | "\(.Name | split("/") | last)=\(.Value)"' > "$env_file.new"
chmod 600 "$env_file.new"
mv "$env_file.new" "$env_file"

docker pull "$image"
docker rm -f backend 2>/dev/null || true
docker run -d --name backend --restart unless-stopped \
  --env-file "$env_file" \
  -e CLIENT_IP_HEADER=x-client-ip \
  -p ${app_port}:${app_port} \
  --log-driver awslogs \
  --log-opt awslogs-region=${aws_region} \
  --log-opt awslogs-group=${log_group_name} \
  --log-opt awslogs-stream=backend-$tag \
  "$image"
SCRIPT
chmod 755 /usr/local/bin/deploy-backend
