# Manual REST Client requests for the auth module (VS Code REST Client).
# With RESEND_API_KEY unset outside production, the backend logs the code instead of emailing it.

@baseUrl = http://localhost:4000
@scenarioVersion = {{$timestamp}}
@email = ana.{{scenarioVersion}}@example.com

### Request a sign-in code (expects 202 with resendAvailableAt and expiresAt)
# @name requestCode
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Request again within 30 seconds (expects 429 signInCode.resend.tooSoon with details.resendAvailableAt)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{email}}",
  "locale": "pt-BR"
}

### Invalid email (expects 422 signInCode.email.invalid)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "ana@",
  "locale": "en"
}

### Unknown locale (expects 422 signInCode.locale.invalid)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "bia.{{scenarioVersion}}@example.com",
  "locale": "fr"
}

### Verify with a wrong code (expects 401 signInCode.code.invalid; counts an attempt)
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "000000"
}

### Verify without a name — for a new email, expects 422 user.name.required and the code stays usable
# Replace the code with the one logged by the backend (or received by email).
@code = 123456
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

### Verify with the name (expects 200 with accessToken, refreshToken and user; the code is consumed)
# @name verify
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}",
  "name": "Ana Rocha"
}

### Verify the same code again (expects 401 signInCode.code.invalid: a code is used once)
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{email}}",
  "code": "{{code}}"
}

### Current account (expects 200 with id, name, email, role, status and createdAt; any account status)
# Replace the token with the accessToken returned by the verify request above.
@accessToken = paste-the-access-token-here
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

### Current account without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/auth/me

### Renew the session (expects 200 with a new accessToken and refreshToken, same shape as verify; the sent token is revoked)
# Replace the token with the refreshToken returned by verify or by the previous refresh.
@refreshToken = paste-the-refresh-token-here
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Renew with the same token again (expects 401 auth.refreshToken.invalid and revokes the whole sign-in)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Renew without a token (expects 422 refreshToken.token.required)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{}
