// Models of the auth module (modules/auth).
// Tables, columns and enums are snake_case in the database (@@map / @map).

enum UserRole {
  student
  instructor
  admin

  @@map("user_role")
}

enum UserStatus {
  pending
  approved
  denied
  deleted
  removed
  // Spec 067: an account deleted or removed 30 days ago, kept as an anonymous record. Not in the domain's
  // USER_STATUSES: PrismaUserRepository never returns an erased account.
  erased

  @@map("user_status")
}

enum UserReactivationStatus {
  requested
  denied

  @@map("user_reactivation_status")
}

enum IdentityProvider {
  google
  apple
  email

  @@map("identity_provider")
}

model User {
  id                      String                  @id @db.Uuid
  // Null once the account is erased (spec 067).
  name                    String?
  email                   String?                 @unique
  photoUrl                String?                 @map("photo_url")
  whatsappNumber          String?                 @map("whatsapp_number")
  whatsappVisible         Boolean                 @default(false) @map("whatsapp_visible")
  role                    UserRole                @default(student)
  status                  UserStatus              @default(pending)
  denialReason            String?                 @map("denial_reason")
  deniedAt                DateTime?               @map("denied_at")
  removedAt               DateTime?               @map("removed_at")
  erasedAt                DateTime?               @map("erased_at")
  reactivationStatus      UserReactivationStatus? @map("reactivation_status")
  reactivationRequestedAt DateTime?               @map("reactivation_requested_at")
  // Spec 070: meaningful only for admins; an admin with it set can also be assigned to teach classes.
  isInstructor            Boolean                 @default(false) @map("is_instructor")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  deletedAt               DateTime?               @map("deleted_at")

  rulesAcceptances  UserRulesAcceptance[]
  identities        Identity[]
  refreshTokens     RefreshToken[]
  schoolRules       SchoolRule[]
  notifications     Notification[]
  pushTokens        PushToken[]
  createdClasses    SchoolClass[]
  classInstructors  ClassInstructor[]
  cancellationRules CancellationRule[]
  enrolments        Enrolment[]
  addedGuests       Guest[]

  @@map("users")
}

model UserRulesAcceptance {
  userId     String   @map("user_id") @db.Uuid
  version    Int
  acceptedAt DateTime @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, version])
  @@map("user_rules_acceptances")
}

model Identity {
  id             String           @id @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  email          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model SignInCode {
  id         String    @id @db.Uuid
  email      String    @unique
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  lastSentAt DateTime  @map("last_sent_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([expiresAt])
  @@map("sign_in_codes")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
