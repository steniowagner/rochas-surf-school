# Manual REST Client requests for the reactivation-requests routes (VS Code REST Client).
# Sign in with the admin review account of REVIEW_ACCOUNTS in apps/backend/.env: set the email and code below.
# A request to decide: sign in as an approved account, DELETE it with DELETE /auth/me, then
# POST /auth/me/reactivation-request as that account.

@baseUrl = http://localhost:4000
@adminEmail = admin@example.com
@adminCode = 345678

### Request a sign-in code for the admin (expects 202)
POST {{baseUrl}}/auth/email/code
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "locale": "pt-BR"
}

### Sign in as the admin (expects 200 with accessToken)
# @name adminSession
POST {{baseUrl}}/auth/email/verify
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "code": "{{adminCode}}"
}

###
@adminToken = {{adminSession.response.body.accessToken}}
# Set to the id of a request returned by the list below.
@userId = 00000000-0000-4000-8000-000000000000

### List the requests, oldest first (expects 200 with { items: [{ id, name, email, role, deletedAt, requestedAt, classesTaken }] })
GET {{baseUrl}}/reactivation-requests
Authorization: Bearer {{adminToken}}

### List without a token (expects 401 auth.token.invalid)
GET {{baseUrl}}/reactivation-requests

### Approve a request (expects 200 with { id, decision: "approved" }; 409 reactivation.status.notRequested when already decided; 404 reactivation.notFound for an unknown id)
POST {{baseUrl}}/reactivation-requests/{{userId}}/approve
Authorization: Bearer {{adminToken}}

### Deny a request with a reason (expects 200 with { id, decision: "denied" }; the reason is trimmed, up to 500 characters)
POST {{baseUrl}}/reactivation-requests/{{userId}}/deny
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": "Turmas cheias."
}

### Deny without a reason (expects 200; denialReason stays empty)
POST {{baseUrl}}/reactivation-requests/{{userId}}/deny
Authorization: Bearer {{adminToken}}

### Deny with an invalid reason (expects 422 reactivation.reason.invalid)
POST {{baseUrl}}/reactivation-requests/{{userId}}/deny
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "reason": 42
}
